{
  "name": "@finance-manager/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node scripts/upload-api-sourcemaps.mjs",
    "postinstall": "prisma generate --schema prisma/schema.prisma && node scripts/copy-sodium-prebuilds.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/secure-session": "^8.3.0",
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^10.70.0",
    "argon2": "^0.44.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.4.0",
    "google-auth-library": "^10.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@sentry/cli": "^2.58.6",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.1.10",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
