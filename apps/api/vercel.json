{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "prebuilds/**",
          "api/prebuilds/**",
          "node_modules/sodium-native/prebuilds/**",
          "../../node_modules/sodium-native/prebuilds/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.ts"
    }
  ]
}
