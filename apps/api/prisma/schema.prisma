generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  APPROVED
  SUSPENDED
}

enum AuthProvider {
  PASSWORD
  GOOGLE
  PASSWORD_AND_GOOGLE
}

enum PasswordResetMethod {
  EMAIL_CODE
  RECOVERY_CODE
}

enum PasswordResetEmailKind {
  RESET_CODE
  GOOGLE_GUIDANCE
}

enum GoogleAuthIntent {
  LOGIN
  REGISTER
}

enum GoogleAuthActionType {
  CREATE_ACCOUNT
  SIGN_IN_WITH_GOOGLE
  SIGN_IN_WITH_PASSWORD
}

enum TransactionType {
  INCOME
  EXPENSE
}

model User {
  id                    String       @id @default(cuid())
  email                 String?      @unique
  username              String?      @unique @db.VarChar(30)
  name                  String       @db.VarChar(100)
  passwordHash          String?
  authProvider          AuthProvider @default(PASSWORD)
  googleSubject         String?      @unique
  role                  Role         @default(USER)
  status                UserStatus   @default(APPROVED)
  sessionVersion        Int          @default(1)
  startingNetWorthCents Int?
  emailVerifiedAt       DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime?    @updatedAt

  transactions         Transaction[]
  recoveryCode         AccountRecoveryCode?
  pendingEmailLink     PendingEmailLink?
  pendingPasswordReset PendingPasswordReset?
  passwordResetGrant   PasswordResetGrant?
  googleAuthActions    PendingGoogleAuthAction[]
}

model PendingRegistration {
  id                   String   @id @default(cuid())
  email                String   @unique
  name                 String   @db.VarChar(100)
  passwordHash         String
  verificationCodeHash String   @db.Char(64)
  verificationAttempts Int      @default(0)
  expiresAt            DateTime
  lastSentAt           DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([updatedAt])
}

model AccountRecoveryCode {
  id        String   @id @default(cuid())
  userId    String   @unique
  codeHash  String   @unique @db.Char(64)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PendingPasswordReset {
  id                   String                 @id @default(cuid())
  userId               String                 @unique
  email                String                 @unique
  kind                 PasswordResetEmailKind
  verificationCodeHash String?                @db.Char(64)
  verificationAttempts Int                    @default(0)
  expiresAt            DateTime
  lastSentAt           DateTime
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

model PasswordResetGrant {
  id               String              @id @default(cuid())
  userId           String              @unique
  method           PasswordResetMethod
  tokenHash        String              @unique @db.Char(64)
  recoveryCodeHash String?             @db.Char(64)
  expiresAt        DateTime
  createdAt        DateTime            @default(now())
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model PendingGoogleAuthAction {
  id            String               @id @default(cuid())
  tokenHash     String               @unique @db.Char(64)
  intent        GoogleAuthIntent
  action        GoogleAuthActionType
  email         String
  name          String               @db.VarChar(100)
  googleSubject String
  userId        String?
  expiresAt     DateTime
  createdAt     DateTime             @default(now())
  user          User?                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
}

model PendingEmailLink {
  id                   String   @id @default(cuid())
  userId               String   @unique
  email                String   @unique
  verificationCodeHash String   @db.Char(64)
  verificationAttempts Int      @default(0)
  expiresAt            DateTime
  lastSentAt           DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

model Category {
  id           String          @id @default(cuid())
  name         String
  type         TransactionType
  transactions Transaction[]

  @@unique([name, type])
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  type        TransactionType
  categoryId  String
  amountCents Int
  description String          @db.VarChar(100)
  occurredOn  DateTime        @db.Date
  createdAt   DateTime        @default(now())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, occurredOn])
  @@index([categoryId])
}
