generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  APPROVED
  SUSPENDED
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  DENIED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  role         Role       @default(USER)
  status       UserStatus @default(APPROVED)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  reviewedAccessRequests AccessRequest[] @relation("AccessRequestReviewer")
  approvedEmails         ApprovedEmail[] @relation("ApprovedEmailApprover")
}

model AccessRequest {
  id           String              @id @default(cuid())
  email        String
  name         String?
  message      String?
  status       AccessRequestStatus @default(PENDING)
  createdAt    DateTime            @default(now())
  reviewedAt   DateTime?
  reviewedById String?

  reviewedBy User? @relation("AccessRequestReviewer", fields: [reviewedById], references: [id])

  @@index([email])
  @@index([status])
  @@index([reviewedById])
}

model ApprovedEmail {
  id           String   @id @default(cuid())
  email        String   @unique
  approvedAt   DateTime @default(now())
  approvedById String?
  usedAt       DateTime?

  approvedBy User? @relation("ApprovedEmailApprover", fields: [approvedById], references: [id])

  @@index([approvedById])
}

