generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  APPROVED
  SUSPENDED
}

enum AccessRequestEventType {
  ACCESS_REQUEST_CREATED
  ACCESS_REQUEST_DISCARDED
  ACCESS_REQUEST_APPROVED
  ACCESS_REQUEST_DENIED
}

enum AccessRequestDiscardReason {
  EMAIL_ALREADY_REGISTERED
  ACCESS_REQUEST_ALREADY_EXISTS
}

enum AccessRequestEventActorType {
  VISITOR
  SYSTEM
  ADMIN
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  role         Role       @default(USER)
  status       UserStatus @default(APPROVED)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  approvedEmails             ApprovedEmail[]      @relation("ApprovedEmailApprover")
  managedAccessRequestEvents AccessRequestEvent[] @relation("AccessRequestEventAdmin")
}

model AccessRequest {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  email     String   @unique
  name      String
  message   String

  events AccessRequestEvent[]
}

model AccessRequestEvent {
  id              String                      @id @default(cuid())
  timestamp       DateTime                    @default(now())
  type            AccessRequestEventType
  actorType       AccessRequestEventActorType
  accessRequestId String?
  email           String
  name            String
  message         String
  adminId         String?
  discardReason   AccessRequestDiscardReason?
  denialReason    String?

  accessRequest AccessRequest? @relation(fields: [accessRequestId], references: [id], onDelete: SetNull)
  admin         User?          @relation("AccessRequestEventAdmin", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([accessRequestId])
  @@index([adminId])
}

model ApprovedEmail {
  id           String    @id @default(cuid())
  email        String    @unique
  approvedAt   DateTime  @default(now())
  approvedById String?
  usedAt       DateTime?

  approvedBy User? @relation("ApprovedEmailApprover", fields: [approvedById], references: [id])

  @@index([approvedById])
}
