generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  APPROVED
  SUSPENDED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum AccessRequestEventType {
  ACCESS_REQUEST_CREATED
  ACCESS_REQUEST_DISCARDED
  ACCESS_REQUEST_APPROVED
  ACCESS_REQUEST_DENIED
}

enum AccessRequestDiscardReason {
  EMAIL_ALREADY_REGISTERED
  ACCESS_REQUEST_ALREADY_EXISTS
}

enum AccessRequestEventActorType {
  VISITOR
  SYSTEM
  ADMIN
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  role         Role       @default(USER)
  status       UserStatus @default(APPROVED)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime?  @updatedAt

  transactions Transaction[]
}

model AccessRequest {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  email     String   @unique
  name      String
  message   String
}

model AccessRequestEvent {
  id              String                      @id @default(cuid())
  timestamp       DateTime                    @default(now())
  type            AccessRequestEventType
  actorType       AccessRequestEventActorType
  accessRequestId String?
  email           String
  name            String
  message         String
  adminId         String?
  discardReason   AccessRequestDiscardReason?
  denialReason    String?

  @@index([accessRequestId])
}

model ApprovedEmail {
  id         String    @id @default(cuid())
  email      String    @unique
  approvedAt DateTime  @default(now())
  usedAt     DateTime?
}

model Category {
  id           String          @id @default(cuid())
  name         String
  type         TransactionType
  transactions Transaction[]

  @@unique([name, type])
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  type        TransactionType
  categoryId  String
  amountCents Int
  description String          @db.VarChar(100)
  occurredAt  DateTime
  createdAt   DateTime        @default(now())
  user        User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  category    Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, occurredAt])
  @@index([categoryId])
}
