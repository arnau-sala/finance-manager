generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  APPROVED
  SUSPENDED
}

enum AuthProvider {
  PASSWORD
  GOOGLE
  PASSWORD_AND_GOOGLE
}

enum TransactionType {
  INCOME
  EXPENSE
}

model User {
  id                    String       @id @default(cuid())
  email                 String       @unique
  name                  String       @db.VarChar(100)
  passwordHash          String?
  authProvider          AuthProvider @default(PASSWORD)
  googleSubject         String?      @unique
  role                  Role         @default(USER)
  status                UserStatus   @default(APPROVED)
  sessionVersion        Int          @default(1)
  startingNetWorthCents Int?
  emailVerifiedAt       DateTime     @default(now())
  createdAt             DateTime     @default(now())
  updatedAt             DateTime?    @updatedAt

  transactions Transaction[]
}

model PendingRegistration {
  id                   String   @id @default(cuid())
  email                String   @unique
  name                 String   @db.VarChar(100)
  passwordHash         String
  verificationCodeHash String   @db.Char(64)
  verificationAttempts Int      @default(0)
  expiresAt            DateTime
  lastSentAt           DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([updatedAt])
}

model Category {
  id           String          @id @default(cuid())
  name         String
  type         TransactionType
  transactions Transaction[]

  @@unique([name, type])
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  type        TransactionType
  categoryId  String
  amountCents Int
  description String          @db.VarChar(100)
  occurredOn  DateTime        @db.Date
  createdAt   DateTime        @default(now())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, occurredOn])
  @@index([categoryId])
}
